        },
        "openapi": {
          "description": "Path of the committed OpenAPI artifact",
          "examples": [
            "/api/v2/openapi.json"
          ],
          "type": "string"
        }
      },
      "required": [
        "openapi",
        "capabilities",
        "identity"
      ],
      "type": "object"
    },
    "TokenPair": {
      "additionalProperties": false,
      "properties": {
        "access_token": {
          "description": "Bearer access token",
          "examples": [
            "eyJhbGciOi..."
          ],
          "type": "string"
        },
        "expires_in": {
          "description": "Access token lifetime in seconds",
          "examples": [
            3600
          ],
          "format": "int64",
          "type": "integer"
