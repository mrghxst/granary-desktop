{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window: only Granary's own commands that the UI uses, plus listening for host events (auth://revoked, player://*, server://event).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-servers-list",
    "allow-servers-probe",
    "allow-servers-add",
    "allow-servers-remove",
    "allow-servers-activate",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-profiles-list",
    "allow-profiles-select",
    "allow-libraries-list",
    "allow-home-sections",
    "allow-catalog-browse",
    "allow-catalog-item",
    "allow-series-seasons",
    "allow-season-episodes",
    "allow-watch-state",
    "allow-player-play",
    "allow-player-stop",
    "allow-player-pause",
    "allow-player-seek",
    "allow-player-set",
    "allow-player-audio",
    "allow-player-subtitle",
    "allow-player-stats",
    "allow-player-state",
    "allow-player-overlay",
    "allow-player-fullscreen",
    "allow-player-mini",
    "allow-player-window",
    "allow-events-connect",
    "allow-events-disconnect",
    "allow-settings-get",
    "allow-settings-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
