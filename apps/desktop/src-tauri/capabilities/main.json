{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window: only Granary's own commands that the UI uses, plus listening for host events (auth://revoked, player://handoff).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-servers-list",
    "allow-servers-probe",
    "allow-servers-add",
    "allow-servers-remove",
    "allow-servers-activate",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-profiles-list",
    "allow-profiles-select",
    "allow-libraries-list",
    "allow-home-sections",
    "allow-catalog-browse",
    "allow-catalog-item",
    "allow-series-seasons",
    "allow-season-episodes",
    "allow-watch-state",
    "allow-player-play",
    "allow-settings-get",
    "allow-settings-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
