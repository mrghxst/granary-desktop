{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window: only Granary's own commands that the UI uses, plus listening for host events (auth://revoked).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-servers-list",
    "allow-servers-probe",
    "allow-servers-add",
    "allow-servers-remove",
    "allow-servers-activate",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-profiles-list",
    "allow-profiles-select",
    "allow-libraries-list",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
