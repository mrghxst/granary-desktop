{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least privilege for the main window: only Granary's own commands that the UI uses, plus listening for host events (auth://revoked, player://*, server://event).",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-app-ready",
    "allow-about-info",
    "allow-open-link",
    "allow-open-trailer",
    "allow-logs-tail",
    "allow-logs-export",
    "allow-servers-list",
    "allow-servers-probe",
    "allow-servers-add",
    "allow-servers-remove",
    "allow-servers-activate",
    "allow-auth-login",
    "allow-auth-logout",
    "allow-profiles-list",
    "allow-profiles-select",
    "allow-libraries-list",
    "allow-home-sections",
    "allow-catalog-browse",
    "allow-catalog-item",
    "allow-series-seasons",
    "allow-season-episodes",
    "allow-watch-state",
    "allow-watch-trickplay",
    "allow-catalog-set-flag",
    "allow-catalog-set-rating",
    "allow-home-dismiss",
    "allow-artwork-keep",
    "allow-artwork-cache-info",
    "allow-artwork-cache-clear",
    "allow-seekr-key-status",
    "allow-seekr-key-set",
    "allow-preview-seekr",
    "allow-person-get",
    "allow-library-sections",
    "allow-library-collections",
    "allow-collection-items",
    "allow-catalog-similar",
    "allow-catalog-filters",
    "allow-player-play",
    "allow-player-stop",
    "allow-player-pause",
    "allow-player-seek",
    "allow-player-set",
    "allow-player-audio",
    "allow-player-subtitle",
    "allow-player-stats",
    "allow-player-preview",
    "allow-player-preview-near",
    "allow-player-preview-warm",
    "allow-player-state",
    "allow-player-overlay",
    "allow-player-fullscreen",
    "allow-player-mini",
    "allow-player-window",
    "allow-player-audio-devices",
    "allow-display-list",
    "allow-events-connect",
    "allow-events-disconnect",
    "allow-settings-get",
    "allow-settings-set",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
