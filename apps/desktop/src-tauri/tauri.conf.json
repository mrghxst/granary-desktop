{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Granary",
  "mainBinaryName": "granary",
  "version": "../package.json",
  "identifier": "io.github.mrghxst.granary",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Granary",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "backgroundColor": "#141417"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "media-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: http://granary-img.localhost granary-img:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Granary contributors",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "category": "Video",
    "shortDescription": "Desktop media client",
    "copyright": "Copyright (C) Granary contributors. Licensed under AGPL-3.0-or-later.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "../../../vendor-bin/libmpv/libmpv-2.dll": "libmpv-2.dll",
      "../../../crates/player/mpv.conf": "mpv.conf",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../../../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
